          "shopkit/users.py"
        ],
        "summary": "Fixed shopkit/users.py.\n\nRoot cause: the formatter interpolated an absent surname, rendering Python\u2019s `None` as text. Restored the `None` guard so single-name users return only their first name.\n\nVerified: `41 passed`.",
        "diff": "diff --git a/shopkit/users.py b/shopkit/users.py\nindex 7123b0a..ef64871 100644\n--- a/shopkit/users.py\n+++ b/shopkit/users.py\n@@ -29,6 +29,8 @@ def full_name(user: User) -> str:\n     Users without a last name render as just their first name \u2014 with no\n     trailing space, which is the whole reason this is not an f-string.\n     \"\"\"\n+    if user.last_name is None:\n+        return user.first_name\n     return f\"{user.first_name} {user.last_name}\"\n \n \n"
      }
